<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        La cotizacion, escrita desde cero: no hereda la plantilla de Odoo, la
        sustituye. Asi el orden de los bloques, los tamanios y los colores son
        nuestros y no dependen de lo que cambie Odoo en cada version.
    -->
    <template id="cotizacion_documento">
        <t t-call="chai_ws_wascardev_reports.layout_wascardev">

            <t t-set="es_borrador" t-value="doc.state in ['draft', 'sent']"/>
            <t t-set="es_proforma" t-value="env.context.get('proforma', False)"/>
            <t t-set="titulo" t-value="'PROFORMA' if es_proforma else ('COTIZACIÓN' if es_borrador else 'ORDEN DE VENTA')"/>
            <t t-set="cliente" t-value="doc.partner_id"/>

            <!-- ═══════════ TÍTULO ═══════════ -->
            <table style="width:100%;border-collapse:collapse;margin-bottom:4px;">
                <tr>
                    <td style="vertical-align:bottom;">
                        <div style="font-size:27px;font-weight:700;color:#0B1F3A;letter-spacing:1.5px;line-height:1.1;">
                            <t t-out="titulo"/>
                        </div>
                    </td>
                    <td style="text-align:right;vertical-align:bottom;white-space:nowrap;">
                        <span style="font-size:12px;color:#64748B;letter-spacing:1px;">N.º </span>
                        <span style="font-size:22px;font-weight:700;color:#2878F8;" t-field="doc.name"/>
                    </td>
                </tr>
            </table>
            <div style="height:3px;background-color:#2878F8;margin-bottom:14px;"/>

            <!-- ═══════════ CLIENTE Y DATOS ═══════════ -->
            <table style="width:100%;border-collapse:collapse;margin-bottom:14px;">
                <tr>
                    <td style="width:53%;vertical-align:top;background-color:#F8FAFD;border:1px solid #E2E8F0;border-left:3px solid #2878F8;padding:9px 13px;">
                        <div style="font-size:10px;font-weight:700;color:#2878F8;letter-spacing:1.4px;margin-bottom:5px;">CLIENTE</div>
                        <div style="font-size:16px;font-weight:700;color:#0B1F3A;line-height:1.25;">
                            <span t-field="cliente.name"/>
                        </div>
                        <div t-if="cliente.vat" style="font-size:12px;color:#334155;margin-top:3px;">
                            <t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'RNC / Cédula'"/>:
                            <span t-field="cliente.vat"/>
                        </div>
                        <div style="font-size:12px;color:#64748B;margin-top:3px;line-height:1.5;">
                            <div t-if="cliente.street"><span t-field="cliente.street"/></div>
                            <div t-if="cliente.city or cliente.country_id">
                                <span t-if="cliente.city" t-field="cliente.city"/><t t-if="cliente.city and cliente.country_id">, </t><span t-if="cliente.country_id" t-field="cliente.country_id.name"/>
                            </div>
                            <div t-if="cliente.phone or cliente.mobile">
                                <span t-if="cliente.phone" t-field="cliente.phone"/><t t-if="cliente.phone and cliente.mobile"> · </t><span t-if="cliente.mobile" t-field="cliente.mobile"/>
                            </div>
                            <div t-if="cliente.email"><span t-field="cliente.email"/></div>
                        </div>
                    </td>

                    <td style="width:2%;"/>

                    <td style="width:45%;vertical-align:top;border:1px solid #E2E8F0;padding:9px 13px;">
                        <table style="width:100%;border-collapse:collapse;font-size:12px;">
                            <tr t-if="doc.date_order">
                                <td style="padding:2px 0;color:#64748B;white-space:nowrap;">
                                    <t t-if="es_borrador">Fecha</t><t t-else="">Fecha del pedido</t>
                                </td>
                                <td style="padding:2px 0;text-align:right;font-weight:700;color:#0B1F3A;">
                                    <span t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                </td>
                            </tr>
                            <tr t-if="doc.validity_date and es_borrador">
                                <td style="padding:2px 0;color:#64748B;white-space:nowrap;">Válida hasta</td>
                                <td style="padding:2px 0;text-align:right;font-weight:700;color:#2878F8;">
                                    <span t-field="doc.validity_date"/>
                                </td>
                            </tr>
                            <tr t-if="doc.client_order_ref">
                                <td style="padding:2px 0;color:#64748B;white-space:nowrap;">Su referencia</td>
                                <td style="padding:2px 0;text-align:right;font-weight:700;color:#0B1F3A;">
                                    <span t-field="doc.client_order_ref"/>
                                </td>
                            </tr>
                            <tr t-if="doc.user_id">
                                <td style="padding:2px 0;color:#64748B;white-space:nowrap;">Responsable</td>
                                <td style="padding:2px 0;text-align:right;font-weight:700;color:#0B1F3A;">
                                    <span t-field="doc.user_id.name"/>
                                </td>
                            </tr>
                            <tr t-if="doc.payment_term_id">
                                <td style="padding:2px 0;color:#64748B;white-space:nowrap;">Forma de pago</td>
                                <td style="padding:2px 0;text-align:right;font-weight:700;color:#0B1F3A;">
                                    <span t-field="doc.payment_term_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ═══════════ LÍNEAS ═══════════ -->
            <t t-set="lineas" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="hay_descuento" t-value="any(l.discount for l in lineas)"/>
            <t t-set="hay_impuestos" t-value="any(imp.amount for l in lineas for imp in l.tax_id)"/>
            <t t-set="solo_exentos" t-value="any(l.tax_id for l in lineas) and not hay_impuestos"/>

            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr style="background-color:#0B1F3A;">
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:10.5px;font-weight:700;letter-spacing:1px;text-align:left;">DESCRIPCIÓN</th>
                        <th style="padding:7px 8px;color:#FFFFFF;font-size:10.5px;font-weight:700;letter-spacing:1px;text-align:right;white-space:nowrap;">CANT.</th>
                        <th style="padding:7px 8px;color:#FFFFFF;font-size:10.5px;font-weight:700;letter-spacing:1px;text-align:right;white-space:nowrap;">PRECIO</th>
                        <th t-if="hay_descuento" style="padding:7px 8px;color:#FFFFFF;font-size:10.5px;font-weight:700;letter-spacing:1px;text-align:right;white-space:nowrap;">DESC.</th>
                        <th t-if="hay_impuestos" style="padding:7px 8px;color:#FFFFFF;font-size:10.5px;font-weight:700;letter-spacing:1px;text-align:right;white-space:nowrap;">IMP.</th>
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:10.5px;font-weight:700;letter-spacing:1px;text-align:right;white-space:nowrap;">IMPORTE</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="subtotal_seccion" t-value="0"/>
                    <t t-set="seccion_actual" t-value="None"/>
                    <t t-foreach="lineas" t-as="line">
                        <t t-set="subtotal_seccion" t-value="subtotal_seccion + line.price_subtotal"/>

                        <t t-if="not line.display_type and line.product_type != 'combo'">
                            <tr style="border-bottom:1px solid #EDF2F7;">
                                <td style="padding:8px 10px;font-size:13px;color:#0B1F3A;vertical-align:top;">
                                    <div style="font-weight:700;">
                                        <span t-if="line.product_id" t-field="line.product_id.display_name"/>
                                        <span t-else="" t-field="line.name"/>
                                    </div>
                                    <div t-if="line.product_id and line.name and len(line.name.split(chr(10))) &gt; 1"
                                         style="font-size:12px;color:#64748B;margin-top:3px;line-height:1.5;white-space:pre-line;">
                                        <span t-out="chr(10).join(line.name.split(chr(10))[1:]).strip()"/>
                                    </div>
                                </td>
                                <td style="padding:8px 8px;font-size:13px;color:#334155;text-align:right;white-space:nowrap;vertical-align:top;">
                                    <span t-field="line.product_uom_qty"/>
                                    <span style="color:#94A3B8;font-size:11px;" t-field="line.product_uom.name"/>
                                </td>
                                <td style="padding:8px 8px;font-size:13px;color:#334155;text-align:right;white-space:nowrap;vertical-align:top;">
                                    <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                                <td t-if="hay_descuento" style="padding:8px 8px;font-size:13px;color:#334155;text-align:right;vertical-align:top;white-space:nowrap;">
                                    <t t-if="line.discount"><span t-out="line.discount" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>%</t>
                                </td>
                                <td t-if="hay_impuestos" style="padding:8px 8px;font-size:11px;color:#64748B;text-align:right;vertical-align:top;white-space:nowrap;">
                                    <span t-out="', '.join([(imp.invoice_label or imp.name) for imp in line.tax_id if imp.amount])"/>
                                </td>
                                <td style="padding:8px 10px;font-size:13px;font-weight:700;color:#0B1F3A;text-align:right;white-space:nowrap;vertical-align:top;">
                                    <span t-if="doc.company_price_include == 'tax_included'" t-field="line.price_total"/>
                                    <span t-else="" t-field="line.price_subtotal"/>
                                </td>
                            </tr>
                        </t>

                        <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                            <tr>
                                <td colspan="99" style="padding:9px 10px 7px 10px;font-size:12.5px;font-weight:700;color:#0B1F3A;background-color:#EAF2FE;border-left:3px solid #2878F8;letter-spacing:.6px;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                            <t t-set="seccion_actual" t-value="line"/>
                            <t t-set="subtotal_seccion" t-value="0"/>
                        </t>

                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td colspan="99" style="padding:6px 10px;font-size:12px;font-style:italic;color:#64748B;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="seccion_actual and (line_last or lineas[line_index+1].display_type == 'line_section' or lineas[line_index+1].product_type == 'combo') and not line.is_downpayment">
                            <t t-set="seccion_actual" t-value="None"/>
                            <tr>
                                <td colspan="99" style="padding:5px 10px;text-align:right;font-size:12px;background-color:#F8FAFD;border-bottom:1px solid #E2E8F0;">
                                    <span style="color:#64748B;margin-right:10px;">Subtotal de la sección</span>
                                    <span style="font-weight:700;color:#0B1F3A;" t-out="subtotal_seccion" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div t-if="solo_exentos" style="margin-top:6px;font-size:11px;color:#64748B;font-style:italic;">
                Precios exentos de ITBIS.
            </div>

            <!-- ═══════════ TOTALES ═══════════ -->
            <table style="width:100%;border-collapse:collapse;margin-top:12px;">
                <tr>
                    <td style="width:58%;vertical-align:top;">
                        <t t-if="doc.signature">
                            <div style="font-size:10px;color:#64748B;letter-spacing:1.2px;">ACEPTADO POR</div>
                            <img t-att-src="image_data_uri(doc.signature)" style="max-height:2.4cm;max-width:5.5cm;margin-top:3px;"/>
                            <div style="font-size:12px;font-weight:700;color:#0B1F3A;">
                                <span t-field="doc.signed_by"/>
                            </div>
                        </t>
                    </td>
                    <td style="width:42%;vertical-align:top;">
                        <table style="width:100%;border-collapse:collapse;">
                            <tr>
                                <td style="padding:8px 12px;font-size:13px;color:#64748B;border:1px solid #E2E8F0;border-bottom:none;">Subtotal</td>
                                <td style="padding:8px 12px;font-size:13px;color:#0B1F3A;text-align:right;white-space:nowrap;border:1px solid #E2E8F0;border-bottom:none;border-left:none;">
                                    <span t-field="doc.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-if="doc.amount_tax">
                                <td style="padding:8px 12px;font-size:13px;color:#64748B;border:1px solid #E2E8F0;border-bottom:none;">Impuestos</td>
                                <td style="padding:8px 12px;font-size:13px;color:#0B1F3A;text-align:right;white-space:nowrap;border:1px solid #E2E8F0;border-bottom:none;border-left:none;">
                                    <span t-field="doc.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="background-color:#0B1F3A;">
                                <td style="padding:10px 12px;font-size:13px;font-weight:700;color:#FFFFFF;letter-spacing:1.2px;">TOTAL</td>
                                <td style="padding:10px 12px;font-size:17px;font-weight:700;color:#FFFFFF;text-align:right;white-space:nowrap;">
                                    <span t-field="doc.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ═══════════ NOTA ═══════════ -->
            <t t-set="nota_vieja" t-value="doc.note and 'Cuentas Bancarias' in (doc.note or '')"/>
            <div t-if="doc.note and not nota_vieja" style="margin-top:14px;font-size:12px;color:#475569;line-height:1.55;">
                <span t-field="doc.note"/>
            </div>
            <div t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)"
                 style="margin-top:8px;font-size:12px;color:#475569;">
                <strong>Nota fiscal:</strong> <span t-field="doc.fiscal_position_id.sudo().note"/>
            </div>

        </t>
    </template>

    <!-- El informe: un t-foreach por documento, cada uno con su propia pagina. -->
    <template id="cotizacion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!--
                    El idioma lo manda la empresa, no el contacto. Antes el PDF
                    salia en ingles -"Untaxed Amount", "Units", fechas
                    09/22/2026- solo porque el cliente tenia en_US en su ficha.
                -->
                <t t-set="idioma_es" t-value="doc.env['res.lang'].sudo().search([('code', 'in', ['es_DO', 'es_ES', 'es_419'])], limit=1).code"/>
                <t t-set="doc" t-value="doc.with_context(lang=idioma_es or doc.env.lang)"/>
                <t t-call="chai_ws_wascardev_reports.cotizacion_documento"/>
            </t>
        </t>
    </template>

    <!--
        El boton Imprimir, el correo al cliente y el portal usan la accion
        estandar de Odoo, asi que se le cambia el informe y el papel a los
        nuestros. Al desinstalar el modulo se devuelven los de Odoo (ver
        hooks.py), de modo que el cambio es reversible.
    -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="report_name">chai_ws_wascardev_reports.cotizacion</field>
        <field name="report_file">chai_ws_wascardev_reports.cotizacion</field>
        <field name="paperformat_id" ref="chai_ws_wascardev_reports.paperformat_wascardev"/>
    </record>

</odoo>
