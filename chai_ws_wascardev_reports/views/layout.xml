<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Papel y estructura propios: no se usa el layout de Odoo.

        El PDF lo dibuja wkhtmltopdf, que es un WebKit viejo: no entiende
        flexbox, grid ni degradados. Por eso el armado va con tablas y colores
        planos, que es lo unico que se ve igual en pantalla y en papel.

        Paleta, tomada del logo:
          #0B1F3A  azul noche, para titulos y la banda del total
          #2878F8  azul de la marca, para acentos
          #EAF2FE  azul muy claro, para fondos suaves
          #64748B  gris de apoyo
          #E2E8F0  bordes
    -->
    <record id="paperformat_wascardev" model="report.paperformat">
        <field name="name">WascarDev - Carta</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <!--
            El margen de arriba tiene que dar cabida a la cabecera completa mas
            su separacion: si se queda corto, wkhtmltopdf recorta la cabecera y
            solo se ve su ultima linea.
        -->
        <field name="margin_top">12</field>
        <field name="margin_bottom">42</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">4</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <!--
        Estructura de pagina. Odoo saca de aqui tres piezas: el div .header va
        al margen superior de cada pagina, el .footer al inferior, y el
        contenido de .article es el cuerpo.
    -->
    <template id="layout_wascardev">
        <t t-set="empresa" t-value="doc.company_id"/>
        <t t-set="socio_empresa" t-value="empresa.partner_id"/>

        <!--
            La cabecera de pagina se deja en una linea y nada mas. El membrete
            -logo y datos- va DENTRO del documento, no aqui: wkhtmltopdf dibuja
            esta zona dentro del margen superior, y si el contenido no le cabe
            justo, lo desplaza y se monta encima del texto. Con una linea no hay
            nada que desplazar, y el membrete se comporta como un bloque mas.
        -->
        <div class="header">
            <div style="height:2px;background-color:#2878F8;"/>
        </div>

        <!-- ══════════ CUERPO ══════════ -->
        <div class="article"
             t-att-data-oe-model="doc and doc._name"
             t-att-data-oe-id="doc and doc.id"
             t-att-data-oe-lang="doc and doc.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <!-- ══════════ PIE ══════════ -->
        <!--
            Los datos para el pago van aqui, no al final del cuerpo. Puestos en
            el cuerpo quedaban justo debajo de los totales y dejaban media hoja
            en blanco; en el pie se apoyan siempre abajo, salga la cotizacion de
            tres lineas o de treinta. Salen de las cuentas bancarias de la
            compania (Contabilidad > Configuracion > Cuentas bancarias).
        -->
        <div class="footer">
            <!-- El pie se dibuja como documento aparte, asi que lleva su propio
                 estilo: si no, hereda los bordes y la tipografia de la base. -->
            <style>
                .chai-pie, .chai-pie * { font-family: "Lato", "Helvetica Neue", Helvetica, Arial, sans-serif; }
                .chai-pie table { border-collapse: collapse; border: 0 !important; }
                .chai-pie tr, .chai-pie td, .chai-pie th { border: 0 !important; }
                .chai-pie * { border-color: transparent; }
            </style>
            <t t-set="cuentas" t-value="socio_empresa.bank_ids.filtered(lambda b: not b.company_id or b.company_id == empresa)"/>
            <div class="chai-pie" style="border-top:2px solid #E2E8F0 !important;padding-top:7px;">
                <table style="width:100%;border-collapse:collapse !important;">
                    <tr>
                        <td style="border:0 !important;width:62%;vertical-align:top;">
                            <t t-if="cuentas">
                                <div style="font-size:10px;font-weight:700;color:#2878F8;letter-spacing:1.4px;margin-bottom:4px;">DATOS PARA EL PAGO</div>
                                <table style="border-collapse:collapse !important;font-size:11.5px;">
                                    <tr t-foreach="cuentas" t-as="cuenta">
                                        <td style="border:0 !important;padding:1px 0;color:#0B1F3A;font-weight:700;white-space:nowrap;">
                                            <span t-if="cuenta.bank_id" t-field="cuenta.bank_id.name"/>
                                            <span t-else="">Cuenta</span>
                                            <span t-if="cuenta.chai_tipo_cuenta" style="font-weight:400;color:#64748B;">
                                                (<t t-out="dict(cuenta._fields['chai_tipo_cuenta'].selection)[cuenta.chai_tipo_cuenta]"/>)
                                            </span>
                                        </td>
                                        <td style="border:0 !important;padding:1px 0 1px 16px;color:#475569;white-space:nowrap;">
                                            <span t-field="cuenta.acc_number"/>
                                        </td>
                                    </tr>
                                </table>
                                <div t-if="cuentas[0].acc_holder_name" style="font-size:11px;color:#64748B;margin-top:2px;">
                                    A nombre de <span t-field="cuentas[0].acc_holder_name"/>
                                </div>
                            </t>
                        </td>
                        <td style="border:0 !important;width:38%;vertical-align:bottom;text-align:right;font-size:10.5px;color:#94A3B8;">
                            <div t-if="empresa.report_header">
                                <span t-field="empresa.report_header"/>
                            </div>
                            <div style="margin-top:2px;white-space:nowrap;">
                                Página <span class="page"/> de <span class="topage"/>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

</odoo>
