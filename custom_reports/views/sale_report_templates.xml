<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta Wascar Dev
    Azul principal:   #0D47A1
    Azul secundario:  #1976D2
    Azul claro:       #64B5F6
    Gris oscuro:      #212121
    Gris claro:       #E0E0E0
-->
<odoo>
<template id="report_saleorder_document_custom" inherit_id="sale.report_saleorder_document" name="Cotización / Pedido - Wascar Dev">

    <xpath expr="//t[@t-call='web.external_layout']" position="replace">
    <t t-call="web.external_layout">

        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>

        <t t-set="address">
            <div t-field="doc.partner_id"
                 t-options='{"widget":"contact","fields":["address","name"],"no_marker":True}'/>
            <p t-if="doc.partner_id.vat">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                   t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">RNC / Cédula</t>:
                <span t-field="doc.partner_id.vat"/>
            </p>
        </t>

        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id
                  and doc.partner_invoice_id != doc.partner_id
                  or doc.partner_shipping_id != doc.partner_invoice_id">
            <t t-set="information_block">
                <strong>
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">Dirección de Factura y Envío</t>
                    <t t-else="">Dirección de Facturación</t>
                </strong>
                <div t-field="doc.partner_invoice_id"
                     t-options='{"widget":"contact","fields":["address","name","phone"],"no_marker":True,"phone_icons":True}'/>
                <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                    <strong class="d-block mt-3">Dirección de Envío</strong>
                    <div t-field="doc.partner_shipping_id"
                         t-options='{"widget":"contact","fields":["address","name","phone"],"no_marker":True,"phone_icons":True}'/>
                </t>
            </t>
        </t>

        <div class="page">

            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Pro-Forma #</span>
                <span t-elif="doc.state in ['draft','sent']">Cotización #</span>
                <span t-else="">Pedido #</span>
                <span t-field="doc.name"/>
            </t>

            <!-- ══════════ CABECERA DE INFORMACIÓN ══════════ -->
            <table style="width:100%;border-collapse:collapse;margin-bottom:12px;">
                <tr>
                    <td t-if="doc.client_order_ref"
                        style="width:25%;padding:8px 12px;background:#FAFAFA;border:1px solid #E0E0E0;vertical-align:top;">
                        <div style="font-size:10px;color:#212121;text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px;">
                            Tu Referencia
                        </div>
                        <div style="font-size:13px;font-weight:700;color:#212121;" t-field="doc.client_order_ref"/>
                    </td>
                    <td t-if="doc.date_order"
                        style="width:25%;padding:8px 12px;background:#FAFAFA;border:1px solid #E0E0E0;vertical-align:top;">
                        <div style="font-size:10px;color:#212121;text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px;">
                            <t t-if="is_proforma">Fecha de Emisión</t>
                            <t t-elif="doc.state in ['draft','sent']">Fecha de Cotización</t>
                            <t t-else="">Fecha del Pedido</t>
                        </div>
                        <div style="font-size:13px;font-weight:700;color:#212121;"
                             t-field="doc.date_order" t-options='{"widget":"date"}'/>
                    </td>
                    <td t-if="doc.validity_date and doc.state in ['draft','sent']"
                        style="width:25%;padding:8px 12px;background:#E3F2FD;border:1px solid #64B5F6;vertical-align:top;">
                        <div style="font-size:9px;color:#1976D2;text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px;">
                            Vence el
                        </div>
                        <div style="font-size:12px;font-weight:700;color:#0D47A1;" t-field="doc.validity_date"/>
                    </td>
                    <td t-if="doc.user_id.name"
                        style="width:25%;padding:8px 12px;background:#FAFAFA;border:1px solid #E0E0E0;vertical-align:top;">
                        <div style="font-size:10px;color:#212121;text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px;">
                            Vendedor
                        </div>
                        <div style="font-size:13px;font-weight:700;color:#212121;" t-field="doc.user_id"/>
                    </td>
                </tr>
                <t t-if="doc.payment_term_id">
                <tr>
                    <td colspan="4"
                        style="padding:8px 14px;background:#FAFAFA;border:1px solid #E0E0E0;vertical-align:top;border-top:none;">
                        <span style="font-size:10px;color:#212121;text-transform:uppercase;letter-spacing:.6px;">
                            Forma de Pago:&#160;
                        </span>
                        <span style="font-size:11px;font-weight:700;color:#212121;" t-field="doc.payment_term_id"/>
                    </td>
                </tr>
                </t>
            </table>

            <!-- ══════════ TABLA DE LÍNEAS ══════════ -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount &gt; 0 for l in lines_to_report)"/>

            <table style="width:100%;border-collapse:collapse;margin-bottom:4px;">
                <thead>
                    <tr style="background-color:#0D47A1;">
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:12px;text-align:left;font-weight:700;letter-spacing:.5px;border:none;">
                            Descripción
                        </th>
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:12px;text-align:right;font-weight:700;white-space:nowrap;border:none;">
                            Cantidad
                        </th>
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:12px;text-align:right;font-weight:700;white-space:nowrap;border:none;">
                            Precio Unitario
                        </th>
                        <th t-if="display_discount"
                            style="padding:7px 10px;color:#FFFFFF;font-size:12px;text-align:right;font-weight:700;border:none;">
                            Desc.%
                        </th>
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:12px;text-align:right;font-weight:700;border:none;">
                            Impuestos
                        </th>
                        <th style="padding:7px 10px;color:#FFFFFF;font-size:12px;text-align:right;font-weight:700;border:none;">
                            Importe
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                        <!-- Línea normal -->
                        <t t-if="not line.display_type and line.product_type != 'combo'">
                            <tr style="border-bottom:1px solid #E0E0E0;">
                                <td style="padding:7px 10px;font-size:13px;color:#212121;vertical-align:top;">
                                    <strong t-if="line.product_id" style="font-size:13px;color:#212121;">
                                        <span t-field="line.product_id.display_name"/>
                                    </strong>
                                    <t t-if="not line.product_id">
                                        <span t-field="line.name"/>
                                    </t>
                                    <div t-if="line.product_id and line.name and len(line.name.split(chr(10))) &gt; 1"
                                         style="font-size:12px;color:#212121;margin-top:2px;white-space:pre-line;">
                                        <span t-out="chr(10).join(line.name.split(chr(10))[1:])"/>
                                    </div>
                                </td>
                                <td style="padding:7px 10px;font-size:13px;text-align:right;color:#212121;white-space:nowrap;vertical-align:top;">
                                    <span t-field="line.product_uom_qty"/>&#160;<span t-field="line.product_uom"/>
                                    <t t-if="line.product_packaging_id">
                                        (<span t-field="line.product_packaging_qty"
                                               t-options='{"widget":"integer"}'/> <span t-field="line.product_packaging_id"/>)
                                    </t>
                                </td>
                                <td style="padding:7px 10px;font-size:13px;text-align:right;color:#212121;white-space:nowrap;vertical-align:top;">
                                    <span t-if="line.discount &lt; 0"
                                          t-out="(1 - line.discount / 100.0) * line.price_unit"
                                          t-options='{"widget":"float","decimal_precision":"Product Price"}'/>
                                    <span t-else="" t-field="line.price_unit"/>
                                </td>
                                <td t-if="display_discount"
                                    style="padding:7px 10px;font-size:13px;text-align:right;color:#212121;vertical-align:top;">
                                    <span t-if="line.discount &gt; 0" t-field="line.discount"/>
                                </td>
                                <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                <td style="padding:7px 10px;font-size:12px;text-align:right;color:#212121;vertical-align:top;">
                                    <span t-out="taxes"/>
                                </td>
                                <td t-if="not line.is_downpayment"
                                    style="padding:7px 10px;font-size:13px;text-align:right;font-weight:700;color:#0D47A1;vertical-align:top;">
                                    <span t-if="doc.company_price_include == 'tax_included'" t-field="line.price_total"/>
                                    <span t-else="" t-field="line.price_subtotal"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Fila de sección -->
                        <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                            <tr style="border-left:3px solid #1976D2;border-top:2px solid #E0E0E0;border-bottom:1px solid #BBDEFB;">
                                <td colspan="99"
                                    style="padding:6px 10px;font-size:13px;font-weight:700;color:#0D47A1;background-color:#E3F2FD;letter-spacing:.3px;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>

                        <!-- Nota -->
                        <t t-elif="line.display_type == 'line_note'">
                            <tr style="border-bottom:1px solid #E0E0E0;">
                                <td colspan="99"
                                    style="padding:5px 10px;font-size:12px;font-style:italic;color:#212121;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Subtotal de sección -->
                        <t t-if="current_section and (
                                line_last
                                or lines_to_report[line_index+1].display_type == 'line_section'
                                or lines_to_report[line_index+1].product_type == 'combo'
                                or (line.combo_item_id and not lines_to_report[line_index+1].combo_item_id)
                            ) and not line.is_downpayment">
                            <t t-set="current_section" t-value="None"/>
                            <tr style="background-color:#F5F5F5;border-top:1px solid #E0E0E0;border-bottom:2px solid #E0E0E0;">
                                <td colspan="99" style="padding:5px 10px;text-align:right;font-size:12px;">
                                    <span style="color:#212121;margin-right:12px;">Subtotal sección</span>
                                    <span t-out="current_subtotal"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'
                                          style="font-weight:700;color:#0D47A1;"/>
                                </td>
                            </tr>
                        </t>

                    </t>
                </tbody>
            </table>

            <!-- ══════════ TOTALES ══════════ -->
            <div style="margin-top:12px;">
                <table style="width:42%;margin-left:auto;border-collapse:collapse;border:1px solid #E0E0E0;">
                    <t t-call="sale.document_tax_totals">
                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                        <t t-set="currency" t-value="doc.currency_id"/>
                    </t>
                </table>
            </div>

            <!-- Firma -->
            <t t-if="doc.signature and doc.env.context.get('sale_include_signature')">
                <div style="margin-top:32px;text-align:right;padding-right:16px;">
                    <strong style="font-size:11px;color:#212121;">Firma</strong><br/>
                    <img t-att-src="image_data_uri(doc.signature)"
                         style="max-height:3.5cm;max-width:7cm;margin-top:4px;"/>
                    <div style="font-size:11px;font-weight:700;color:#212121;margin-top:4px;">
                        <span t-field="doc.signed_by"/>
                    </div>
                </div>
            </t>

            <!-- Nota y términos de pago -->
            <div style="margin-top:20px;font-size:11px;color:#212121;">
                <span t-field="doc.note"
                      t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}"/>
                <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)"
                   style="margin-top:6px;">
                    <strong>Nota Fiscal:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note"/>
                </p>
            </div>

        </div>
    </t>
    </xpath>
</template>
</odoo>
