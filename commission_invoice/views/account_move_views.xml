<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_commission_inherit" model="ir.ui.view">
        <field name="name">account.move.form.commission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_commissions" type="object"
                        class="oe_stat_button" icon="fa-percent"
                        invisible="commission_count == 0">
                    <field name="commission_count" widget="statinfo" string="Comisiones"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
